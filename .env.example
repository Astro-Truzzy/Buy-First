# Template for .env — copy this file to ".env" and fill in real values.
# Never put real secrets in this file; it IS committed to git.

APP_NAME=BuyFirst
APP_URL=http://localhost:8000
# Set to false on any machine that is not your laptop.
APP_DEBUG=true

# This project uses a local MariaDB on port 3307 (see README).
# Plain XAMPP MySQL is usually 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=buyfirst
DB_USER=root
DB_PASS=

# log  = write HTML files to storage/mail/ (local inbox)
# smtp = send through MAIL_HOST. MAIL_FROM should match MAIL_USERNAME.
MAIL_DRIVER=log
MAIL_FROM=orders@buyfirst.test
MAIL_FROM_NAME=BuyFirst
MAIL_CONTACT=orders@buyfirst.test

# SMTP (used when MAIL_DRIVER=smtp)
# Hostinger: smtp.hostinger.com  port 465  encryption ssl
# Gmail:     smtp.gmail.com      port 587  encryption tls  (App Password)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
